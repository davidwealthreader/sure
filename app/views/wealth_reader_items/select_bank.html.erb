<%= turbo_frame_tag "modal" do %>
  <%= render DS::Dialog.new do |dialog| %>
    <% dialog.with_header(title: t(".title", default: "Choose your bank")) %>
    <% dialog.with_body do %>
      <div class="space-y-4" data-controller="bank-search">
        <% if @error_message.present? %>
          <div class="p-3 rounded-lg bg-destructive/10 text-destructive text-sm"><%= @error_message %></div>
        <% end %>

        <% if @entities.present? %>
          <%= render DS::SearchInput.new(
                placeholder: t(".search_placeholder", default: "Search banks"),
                aria_label: t(".search_label", default: "Search banks"),
                autofocus: true,
                data: { bank_search_target: "input", action: "input->bank-search#filter" }
              ) %>
          <div class="space-y-2 max-h-80 overflow-y-auto">
            <% @entities.each do |entity| %>
              <div data-bank-search-target="item" data-bank-search="<%= [ entity[:name], entity[:code] ].compact.join(" ").downcase %>">
                <%= button_to authorize_wealth_reader_item_path(@wealth_reader_item),
                              method: :post,
                              params: { entity_code: entity[:code], new_connection: @new_connection ? "true" : nil }.compact,
                              class: "w-full flex items-center gap-4 p-3 rounded-lg border border-primary bg-container hover:bg-subtle text-left",
                              data: { turbo: false } do %>
                  <div class="flex-1 min-w-0">
                    <p class="font-medium text-sm text-primary"><%= entity[:name] %></p>
                    <p class="text-xs text-secondary"><%= entity[:code] %></p>
                  </div>
                  <%= icon "chevron-right", class: "w-5 h-5 text-secondary" %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-secondary text-sm"><%= t(".no_banks", default: "No banks found for this country.") %></p>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
